    "screenfull": "^6.0.2",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.6",
    "@eslint/js": "^10.0.1",
    "@formatjs/cli": "~6.14.5",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/humps": "^2.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.4.0",
    "@types/qs": "^6.15.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
