{
  "name": "trackline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26"
    },
    "packageManager": {
      "name": "npm",
      "version": "^11 || ^12"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
