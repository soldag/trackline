    "@vitejs/plugin-react": "^6.1.1",
    "colors": "^1.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-formatjs": "^6.6.1",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-refresh": "^0.5.5",
    "glob": "^13.0.6",
    "globals": "^17.11.0",
    "lodash-es": "^4.18.1",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "type-fest": "^5.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2"
  },
  "allowScripts": {
    "@sentry/cli@2.58.6": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "start": "vite dev",
    "build": "tsc && vite build",
    "type-check": "tsc --noEmit",
    "i18n:extract": "formatjs extract 'src/**/*.{js,jsx,ts,tsx}' --out-file messages.json && formatjs compile messages.json --out-file src/translations/en.json && rm messages.json",
    "i18n:check": "tsx scripts/checkTranslations.ts",
    "lint": "eslint --max-warnings=0 --fix .",
    "format": "prettier --write '**/*.{js,jsx,cjs,ts,tsx,html,css,md,json}' --config .prettierrc.cjs"
  }
}
